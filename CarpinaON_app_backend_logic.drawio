        <mxCell id="step_0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=4;" value="1. Cidadão escolhe categoria → serviço → preenche formulário (CEP, endereço, complemento, referência)" vertex="1">
          <mxGeometry height="70" width="300" x="340" y="25" as="geometry" />
        </mxCell>
        <mxCell id="step_1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=4;" value="2. API recebe POST /solicitacoes valida token JWT do usuário" vertex="1">
          <mxGeometry height="70" width="300" x="670" y="145" as="geometry" />
        </mxCell>
        <mxCell id="step_2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=left;spacingLeft=4;" value="3. (opcional) API consulta ViaCEP para validar/completar endereço" vertex="1">
          <mxGeometry height="70" width="300" x="1000" y="265" as="geometry" />
        </mxCell>
        <mxCell id="step_3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=4;" value="4. Grava SOLICITACAO (status=RECEBIDA) gera protocolo único (ANO-XXXX)" vertex="1">
          <mxGeometry height="70" width="300" x="1330" y="385" as="geometry" />
        </mxCell>
        <mxCell id="step_4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=4;" value="5. API manda notificação &#39;Solicitação recebida - protocolo X&#39;" vertex="1">
          <mxGeometry height="70" width="300" x="1660" y="145" as="geometry" />
        </mxCell>
        <mxCell id="step_5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=4;" value="6. App mostra protocolo ao cidadão (tela &#39;Meus Pedidos&#39;)" vertex="1">
          <mxGeometry height="70" width="300" x="1990" y="25" as="geometry" />
        </mxCell>
        <mxCell id="step_6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=4;" value="7. Admin acessa fila de solicitações no backoffice, filtra por categoria/status" vertex="1">
          <mxGeometry height="70" width="300" x="2320" y="505" as="geometry" />
        </mxCell>
        <mxCell id="step_7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=4;" value="8. Admin muda status via PATCH /solicitacoes/{id}/status" vertex="1">
          <mxGeometry height="70" width="300" x="2650" y="145" as="geometry" />
        </mxCell>
        <mxCell id="step_8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=left;spacingLeft=4;" value="9. API grava HISTORICO_STATUS e atualiza SOLICITACAO.status" vertex="1">
          <mxGeometry height="70" width="300" x="2980" y="385" as="geometry" />
        </mxCell>
        <mxCell id="step_9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=4;" value="10. API manda notificação de mudança de status pro cidadão" vertex="1">
          <mxGeometry height="70" width="300" x="3310" y="145" as="geometry" />
        </mxCell>
        <mxCell id="step_10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=4;" value="11. Cidadão recebe push e vê status atualizado em &#39;Meus Pedidos&#39;" vertex="1">
