{
	"info": {
		"_postman_id": "carpinaon-collection-2026",
		"name": "CarpinaON",
		"description": "API do CarpinaON - Portal de serviços municipais\n\nBase: http://localhost:8080 (local) ou https://carpinaon-api.onrender.com (Render)\n\nUso: rode o request \"Login\" primeiro para o token ser salvo automaticamente na variável {{token}}.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "protocolo",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Cadastrar cidadão",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Cadastro retorna 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test(\"Retorna dados do usuário\", function () {",
									"    var json = pm.response.json();",
									"    pm.expect(json).to.have.property('id');",
									"    pm.expect(json).to.have.property('nome');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"nome\": \"Maria da Silva\",\n    \"cpf\": \"12345678901\",\n    \"email\": \"maria@teste.com\",\n    \"telefone\": \"81999999999\",\n    \"senha\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/cadastrar",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "cadastrar"]
						},
						"description": "Cadastra um novo cidadão. CPF é único. Retorna os dados sem a senha."
					}
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login retorna 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"// Salva o token automaticamente pra usar nos outros requests",
									"var json = pm.response.json();",
									"if (json.token) {",
									"    pm.collectionVariables.set('token', json.token);",
									"}",
									"",
									"pm.test(\"Retorna token JWT\", function () {",
									"    pm.expect(json).to.have.property('token');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"cpf\": \"12345678901\",\n    \"senha\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login por CPF + senha. Salva o token JWT na variável {{token}} automaticamente. Token válido por 24h."
					}
				}
			]
		},
