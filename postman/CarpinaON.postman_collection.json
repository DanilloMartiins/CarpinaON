		},
		{
			"name": "Solicitações",
			"item": [
				{
					"name": "Criar solicitação",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Criação retorna 201\", function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"// Salva o protocolo pra usar no request de buscar por protocolo",
									"var json = pm.response.json();",
									"if (json.protocolo) {",
									"    pm.collectionVariables.set('protocolo', json.protocolo);",
									"}",
									"",
									"pm.test(\"Retorna protocolo\", function () {",
									"    pm.expect(json).to.have.property('protocolo');",
									"    pm.expect(json.status).to.eql('RECEBIDA');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"servicoIds\": [1],\n    \"cep\": \"55815000\",\n    \"complemento\": \"\",\n    \"pontoReferencia\": \"Proximo ao mercado\",\n    \"descricao\": \"Buraco na rua em frente a minha casa\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/solicitacoes",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "solicitacoes"]
						},
						"description": "Cria uma solicitação (protocolo). Requer token JWT. servicoIds aceita apenas 1 serviço por vez."
					}
				},
				{
					"name": "Listar minhas solicitações",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Retorna 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/solicitacoes",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "solicitacoes"]
						},
						"description": "Lista os protocolos do usuário logado (resumido)."
					}
				},
				{
					"name": "Buscar por protocolo",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Retorna 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/v1/solicitacoes/{{protocolo}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "solicitacoes", "{{protocolo}}"]
						},
						"description": "Busca uma solicitação pelo protocolo. Traz detalhe completo: serviço, anexos e histórico de status."
					}
				},
				{
					"name": "Atualizar status",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Retorna 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Status atualizado\", function () {",
									"    pm.expect(pm.response.json().status).to.eql('EM_ANDAMENTO');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"EM_ANDAMENTO\",\n    \"observacao\": \"Equipe alocada para atendimento\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/solicitacoes/2/status",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "solicitacoes", "2", "status"]
						},
						"description": "Atualiza o status (admin). Status válidos: RECEBIDA, EM_ANALISE, EM_ANDAMENTO, RESOLVIDA, INDEFERIDA, CANCELADA. INDEFERIDA exige observação. Troque o /2 pelo id da solicitação."
					}
				}
			]
		},
